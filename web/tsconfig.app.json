{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "rootDir": "..",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src", "../cameras/*.json", "../schema/*.json", "../testset/engine/*.json", "../testset/parser/*.json"],
  "exclude": ["src/sw.ts"]
}
