{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rootDir": "..",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "vite.sw.config.ts",
    "tools",
    "src/lib/engine",
    "src/lib/strings.ts",
    "src/lib/validate.ts",
    "src/lib/headersFile.ts",
    "../cameras/*.json",
    "../schema/*.json"
  ],
  "exclude": ["src/**/*.test.ts"]
}
