{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "emitDeclarationOnly": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo"
  },
  "include": ["src/sw.ts", "src/lib/offline.ts"]
}
